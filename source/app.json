{
  "expo": {
    "name": "Kitchen Kaki",
    "slug": "kitchen-kaki",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#2F5BA8"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "sg.kitchenkaki.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#2F5BA8",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "sg.kitchenkaki.app"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Kitchen Kaki uses your photos so you can add your own picture of a dish.",
          "cameraPermission": "Kitchen Kaki uses the camera so you can take a picture of a dish you cooked."
        }
      ]
    ]
  }
}
